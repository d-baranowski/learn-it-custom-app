{
  "name": "notification",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "app/notification",
  "tags": ["api", "go", "backend"],
  "targets": {
    "generate": {},
    "migrate": {
      "dependsOn": [
        {
          "projects": ["core"],
          "target": "migrate"
        }
      ]
    },
    "build": {},
    "serve": {},
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/app/notification",
        "command": "USER=postgres ENV_FILE=./.env.dev air -c air.toml"
      }
    },
    "test": {},
    "lint": {},
    "tidy": {},
    "container": {}
  }
}
