{
  "name": "core-event",
  "projectType": "application",
  "sourceRoot": "app/core-event",
  "tags": ["go", "backend"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/app/core-event",
        "command": "go build -o ./tmp/core-event ./cmd/"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/app/core-event",
        "command": "USER=postgres ENV_FILE=./.env.dev air -c air.toml"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["core"],
          "target": "migrate"
        }
      ],
      "options": {
        "cwd": "{workspaceRoot}/app/core-event",
        "command": "USER=postgres ENV_FILE=./.env.dev go run ./cmd/ -migrate"
      }
    },

    "container": {
      "options": {
        "file": "docker/Dockerfile.core-event"
      }
    }
  }
}
