{
  "name": "gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "app/gateway",
  "tags": [],
  "targets": {

    "build": {
      "dependsOn": [
        "api:generate",
        "billing:generate",
        "core:generate",
        "nis:generate",
        "smpp:generate"
      ]
    },
    "serve": {},
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/app/gateway",
        "command": "USER=postgres ENV_FILE=./.env.dev air -c air.toml"
      }
    },
    "test": {},
    "lint": {},
    "tidy": {},
    "container": {}
  }
}
