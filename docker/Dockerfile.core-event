# core-event ships its WAL filter config alongside the binary, which the
# shared docker/Dockerfile (binary-only image) can't express. Build flags
# mirror docker/Dockerfile — native-arch builder + Go cross-compilation,
# static binary for the alpine runtime stage.
FROM --platform=$BUILDPLATFORM golang:1.24.13-alpine AS builder
ARG TARGETOS
ARG TARGETARCH
COPY . /build
WORKDIR /build
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -o ./dist/app/core-event ./app/core-event/cmd/

FROM alpine:3.20.1
LABEL org.opencontainers.image.source=https://github.com/inspiration-particle/utro
RUN apk add --no-cache tzdata
COPY --from=builder /build/dist/app/core-event /app/core-event
COPY --from=builder /build/app/core-event/filter.yaml /app/filter.yaml
ENV WAL_FILTER_FILE=/app/filter.yaml
ENTRYPOINT ["/app/core-event"]
