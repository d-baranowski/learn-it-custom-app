# Dependencies
node_modules/
.pnpm-store/

# Build / cache output
dist/
build/
out/
.next/
.nx/cache
.nx/workspace-data
tmp/

# Protobuf codegen output. Every buf.gen.yaml in the repo declares `out: gen`,
# and the tree is regenerated from the .proto files on demand — CI does it in
# utroPrepare (`nx run-many -t generate`) before anything builds. Committing it
# would add review noise and a second source of truth that drifts silently
# whenever someone edits a .proto without re-running codegen.
gen/

# Test / coverage
coverage/
test-output/

# Environment files — never commit real values; ship .example templates only
.env
.env.*
!.env.example
!.env.*.example

# Logs / editor / OS
*.log
.DS_Store
.idea/
.vscode/
